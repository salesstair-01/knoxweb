# Admin + builder: Puck editor, page storage, static site publisher.
# Build the app on the host (or in CI) first: `npm ci && npm run build`.
ARG NODE_IMAGE=node:22-alpine
FROM ${NODE_IMAGE}
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0
COPY .next/standalone ./
COPY .next/static ./.next/static
COPY public ./public
COPY seed ./seed
VOLUME ["/app/.data"]
EXPOSE 3000
# AppSail provides the port in X_ZOHO_CATALYST_LISTEN_PORT.
CMD ["sh", "-c", "PORT=${X_ZOHO_CATALYST_LISTEN_PORT:-${PORT:-3000}} exec node server.js"]
